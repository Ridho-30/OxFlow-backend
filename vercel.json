{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.js"
    }
  ],
  "crons": [
    {
      "path": "/api/auth/login",
      "schedule": "0 0 */3 * *"
    },
    {
      "path": "/api/laporan/cron/generate-laporan",
      "schedule": "59 23 * * *"
    }
  ]
}
