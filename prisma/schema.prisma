generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model budget {
  budget_id  Int       @id @default(autoincrement())
  user_id    String    @unique @db.Uuid
  income     Decimal   @default(0) @db.Decimal(15, 2)
  threshold  Decimal   @default(0) @db.Decimal(15, 2)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_budget_user_id")
}

model detail_transaction {
  detail_transaction_id Int         @id @default(autoincrement())
  transaction_id        Int
  name_items            String      @db.VarChar(255)
  quantity              Int         @default(1)
  price                 Decimal     @db.Decimal(15, 2)
  subtotal              Decimal     @db.Decimal(15, 2)
  transaction           transaction @relation(fields: [transaction_id], references: [transaction_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transaction_id], map: "idx_detail_transaction_transaction_id")
}

model categories {
  category_id   Int           @id @default(autoincrement())
  name_category String        @db.VarChar(255)
  is_default    Boolean       @default(true)
  deleted_at    DateTime?     @db.Timestamp(6)
  transaction   transaction[]

  @@map("categories")
}

model laporan {
  laporan_id         Int       @id @default(autoincrement())
  user_id            String    @db.Uuid
  report_date        DateTime  @db.Date
  file_url           String    @db.VarChar(255)
  income_snapshot    Decimal?  @db.Decimal(15, 2)
  threshold_snapshot Decimal?  @db.Decimal(15, 2)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_laporan_user_id")
}

model transaction {
  transaction_id     Int                  @id @default(autoincrement())
  user_id            String               @db.Uuid
  category_id        Int
  nama_toko          String?              @db.VarChar(255)
  total              Decimal              @db.Decimal(15, 2)
  date               DateTime             @db.Date
  foto_struk         String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  deleted_at         DateTime?            @db.Timestamp(6)
  detail_transaction detail_transaction[]
  categories         categories           @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  users              users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_transaction_date")
  @@index([category_id], map: "idx_transaction_category_id")
  @@index([user_id], map: "idx_transaction_user_id")
}

model users {
  user_id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @db.VarChar(255)
  email           String        @unique @db.VarChar(255)
  password        String        @db.VarChar(255)
  profile_picture String?
  fcm_token       String?
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  updated_at      DateTime?     @default(now()) @db.Timestamp(6)
  deleted_at      DateTime?     @db.Timestamp(6)
  budget          budget?
  laporan         laporan[]
  transaction     transaction[]

  @@index([email], map: "idx_users_email")
}
